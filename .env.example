# Better Auth
BETTER_AUTH_SECRET=changeme-generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Database (Postgres)
DB_NAME=whennottomeet
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432
DB_SSL=false

# GitHub OAuth (optional — callback: {BETTER_AUTH_URL}/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SMTP (Mailpit in dev — no auth, so user/pass are optional)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=noreply@whennottomeet.app
SMTP_SENDER_NAME=WhenNotToMeet
